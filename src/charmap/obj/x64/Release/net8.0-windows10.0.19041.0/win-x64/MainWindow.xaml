<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="charmap.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:charmap"
    mc:Ignorable="d">

    <Grid x:ConnectionId='2' x:Name="RootGrid" x:FieldModifier="public">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <Grid x:ConnectionId='3' x:Name="AppTitleBar" x:FieldModifier="public" Height="48" VerticalAlignment="Top" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:ConnectionId='15' x:Name="TitleTextBlock" x:FieldModifier="public"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Padding="12,8,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar: Font selector + Help -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:ConnectionId='12' x:Name="FontLabel" x:FieldModifier="public"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:ConnectionId='13' x:Name="FontComboBox" x:FieldModifier="public"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Stretch"
                          SelectedIndex="0"/>
                <Button x:ConnectionId='14' x:Name="HelpButton" x:FieldModifier="public"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                                                />
            </Grid>

            <!-- Character Grid -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,8">
                <GridView x:ConnectionId='9' x:Name="CharacterGridView" x:FieldModifier="public"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                                                                 >
                    <GridView.ItemTemplate>
                        <DataTemplate                                 >
                            <Button x:ConnectionId='11'                             
                                    FontSize="18"
                                    Padding="4"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                                  />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           MaximumRowsOrColumns="32"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </ScrollViewer>

            <!-- Copy section -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:ConnectionId='5' x:Name="CopyLabel" x:FieldModifier="public"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:ConnectionId='6' x:Name="CopyTextBox" x:FieldModifier="public"
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         IsReadOnly="True"
                         Text=""/>
                <Button x:ConnectionId='7' x:Name="SelectButton" x:FieldModifier="public"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                                                  />
                <Button x:ConnectionId='8' x:Name="CopyButton" x:FieldModifier="public"
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                                                />
            </Grid>

            <!-- Advanced view checkbox -->
            <CheckBox x:ConnectionId='4' x:Name="AdvancedViewCheckBox" x:FieldModifier="public"
                      Grid.Row="3"
                      IsChecked="False"
                      IsEnabled="False"
                      ToolTipService.ToolTip="Coming soon"/>
        </Grid>
    </Grid>
</Window>

